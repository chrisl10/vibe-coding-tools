{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "node .cursor/hooks/dash-guard.mjs",
        "matcher": "Write|Edit",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "postToolUse": [
      {
        "command": "node .cursor/hooks/component-validate.mjs",
        "matcher": "Write|Edit",
        "timeout": 30
      }
    ]
  }
}
